# Copy to .env and fill in. Never commit .env. (Comments must be on their own lines.)

# Private, unguessable subdomain pointing to this server (DNS A-record), e.g. x7k2.example.com
XAHOO_DOMAIN=x7k2.example.com
XAHOO_ADMIN_PASSWORD=change-me-long-passphrase
# Random string, e.g. output of: openssl rand -hex 32
XAHOO_SECRET=change-me-random
# Optional 2-step login code. Create with: docker compose run --rm xahoo python -m xahoo.security
XAHOO_TOTP_SECRET=
XAHOO_VAPID_SUB=mailto:admin@xahoo.invalid
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# "Get ready" alerts while a setup forms (~5-6/day, ~1 in 5 becomes a signal): on | off
XAHOO_PREALERTS=on
XAHOO_REPLAY_DAYS=30
