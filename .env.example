# Copy to .env on the server (chmod 600). Never commit .env.
XAHOO_ADMIN_PASSWORD=choose-a-long-password
# Random string that signs the login cookie, e.g. the output of: openssl rand -hex 32
XAHOO_SECRET=
# Optional 2-step login: python -m xahoo.security prints a secret to add to an authenticator app
XAHOO_TOTP_SECRET=
